# ────────────────────────────────────────────────────────────
#  .env del backend (EC2).
#  El pipeline (.github/workflows/deploy.yml) genera este archivo
#  desde los GitHub secrets al hacer deploy; NO lo subas al repo.
#  Copia este ejemplo como base para pruebas locales.
# ────────────────────────────────────────────────────────────

# Mismo Application (client) ID que el front (login Microsoft).
MICROSOFT_CLIENT_ID=89fde275-566d-498a-a663-bbed17a2a29d
# Clave de firma HS256 de los JWT locales, minimo 32 caracteres.
# Debe ser LA MISMA en auth-service, inventory-service y orders-service.
LOCAL_JWT_SECRET=clave-secreta-propia-de-al-menos-32-caracteres
# Origen que el navegador usa (IP publica del front). Sin esto,
# inventario/pedidos rechazan peticiones por CORS.
CORS_ALLOWED_ORIGIN=http://<IP-PUBLICA-FRONT>